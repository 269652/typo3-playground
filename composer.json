{
    "name": "playground/typo3-playground",
    "description": "TYPO3 14 playground: site package with site set + backend layouts, and a demo Extbase plugin",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-install": "^14.3",
        "typo3/cms-lowlevel": "^14.3",
        "typo3/cms-setup": "^14.3",
        "playground/site-package": "@dev",
        "playground/demo-plugin": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/yaml": "^7.0",
        "typo3/testing-framework": "^9.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "web-dir": "public"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    },
    "autoload-dev": {
        "psr-4": {
            "Playground\\Tests\\": "tests/"
        }
    }
}
